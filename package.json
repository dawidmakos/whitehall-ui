{
  "name": "whitehall-ui",
  "version": "3.0.1",
  "type": "module",
  "description": "Component library based on the GOV.UK Design System, for React 19 + Tailwind CSS 4. Available as an npm package and a shadcn-compatible registry.",
  "license": "MIT",
  "author": "dawidmakos",
  "homepage": "https://dawidmakos.github.io/whitehall-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dawidmakos/whitehall-ui.git"
  },
  "bugs": {
    "url": "https://github.com/dawidmakos/whitehall-ui/issues"
  },
  "keywords": [
    "govuk",
    "gov.uk",
    "design-system",
    "react",
    "tailwindcss",
    "shadcn",
    "components",
    "ui"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "tokens.css",
    "registry/default/theme/govuk-tokens.css",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./lib/utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js"
    },
    "./*": {
      "types": "./dist/ui/*.d.ts",
      "import": "./dist/ui/*.js"
    }
  },
  "scripts": {
    "build:lib": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "registry:build": "node scripts/build-registry.mjs",
    "prepublishOnly": "npm run build:lib",
    "test": "vitest --project=storybook"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-storybook": "^10.6.7",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
