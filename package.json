    },
    "./task-list": {
      "types": "./dist/ui/task-list.d.ts",
      "import": "./dist/ui/task-list.js"
    },
    "./text-input": {
      "types": "./dist/ui/text-input.d.ts",
      "import": "./dist/ui/text-input.js"
