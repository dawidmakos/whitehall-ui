      "import": "./dist/ui/date-input.js"
    },
    "./details": {
      "types": "./dist/ui/details.d.ts",
      "import": "./dist/ui/details.js"
    },
    "./error-message": {
      "types": "./dist/ui/error-message.d.ts",
      "import": "./dist/ui/error-message.js"
